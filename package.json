{
  "name": "regicap",
  "private": true,
  "version": "2.0.0",
  "description": "REGICAP — Sistema de Registro Inteligente para Capacitaciones",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @regicap/db generate",
    "db:migrate": "pnpm --filter @regicap/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @regicap/db migrate:dev",
    "db:seed": "pnpm --filter @regicap/db seed",
    "db:reset": "pnpm --filter @regicap/db reset",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down",
    "verify": "node --env-file=.env scripts/verify.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
