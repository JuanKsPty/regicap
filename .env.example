# ───────── REGICAP · variables de entorno ─────────
# Copia este archivo a `.env` (raíz del monorepo). Lo leen la API, el worker,
# el seed y docker-compose.

# --- PostgreSQL (el contenedor publica el puerto 5433 para no chocar con otros) ---
POSTGRES_USER=regicap
POSTGRES_PASSWORD=regicap
POSTGRES_DB=regicap
POSTGRES_PORT=5433
DATABASE_URL=postgresql://regicap:regicap@localhost:5433/regicap?schema=public

# --- Redis (cola de calificación BullMQ, persistencia AOF) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Almacenamiento de objetos S3 (MinIO en local; intercambiable por R2/S3) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
# Origen con el que el NAVEGADOR llega al almacenamiento (producción: https://<dominio>)
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Prefijo de ruta bajo el que el proxy publica el almacenamiento (Traefik: /files). Vacío en desarrollo.
S3_PUBLIC_PATH_PREFIX=
S3_REGION=us-east-1
S3_BUCKET=regicap
S3_ACCESS_KEY=regicap
S3_SECRET_KEY=regicap-secret
S3_FORCE_PATH_STYLE=true

# --- API (NestJS) ---
API_PORT=3001
# Cambia este secreto en producción (mínimo 32 caracteres).
JWT_SECRET=cambia-este-secreto-en-produccion-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
# Origen del front (solo se usa para CORS en desarrollo; en producción comparten dominio)
WEB_ORIGIN=http://localhost:3000

# --- Calificación con IA ---
# mock → MockIAProvider determinista (por defecto) · anthropic → API de Claude
IA_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Simula caídas del proveedor (útil para probar EC-09): true | false
IA_MOCK_FALLAR=false
# Primer espera del reintento exponencial en ms (30 s, 60 s, 120 s… en producción)
CALIFICACION_BACKOFF_MS=30000

# --- Web (Next.js) ---
WEB_PORT=3000
# URL interna de la API para el rewrite /api/* y el SSR
API_INTERNAL_URL=http://localhost:3001
# Mismo secreto que la API: el middleware verifica el JWT para redirigir por rol
# (la autoridad final siempre es la API).
