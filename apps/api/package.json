{
  "name": "@regicap/api",
  "version": "2.0.0",
  "private": true,
  "description": "REGICAP — capa de lógica de negocio (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "concurrently -k -n api,worker -c blue,magenta \"nest start --watch\" \"nest start --watch --entryFile worker\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.3",
    "@regicap/db": "workspace:*",
    "@regicap/types": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.14.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@regicap/config": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.13.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
