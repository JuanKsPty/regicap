{
  "name": "@regicap/db",
  "version": "2.0.0",
  "private": true,
  "description": "Prisma: esquema, migraciones y seed de REGICAP",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "prisma generate",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@regicap/config": "workspace:*",
    "@regicap/types": "workspace:*",
    "@types/node": "^22.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
