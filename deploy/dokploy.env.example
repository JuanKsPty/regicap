# Variables de REGICAP en Dokploy (compose «regicap» → Environment).
# Genera cada secreto con:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# URL pública (sin barra final). También es el origen de las URLs firmadas de PDF.
PUBLIC_URL=https://regicap.juank.tech

POSTGRES_PASSWORD=
S3_SECRET_KEY=
# Mínimo 32 caracteres. Firma la cookie de sesión.
JWT_SECRET=

# true → siembra la demo (cuentas de ejemplo con contraseña pública) si la base está vacía
SEED_DEMO=true

# mock (determinista) | anthropic
IA_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
